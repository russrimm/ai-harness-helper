{
  "name": "ai-harness-helper",
  "version": "0.1.1",
  "type": "module",
  "description": "Discover, inspect, and edit every agentic AI harness configuration file on your machine.",
  "license": "MIT",
  "author": "Russ Rimmerman",
  "homepage": "https://github.com/russrimm/ai-harness-helper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russrimm/ai-harness-helper.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/russrimm/ai-harness-helper/issues"
  },
  "keywords": [
    "mcp",
    "agentic",
    "ai",
    "copilot",
    "claude-code",
    "cursor",
    "configuration",
    "audit",
    "context-window",
    "cli"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ai-harness-helper": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc --build && node ./scripts/copy-web-assets.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@ai-harness-helper/core": "workspace:^",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.10.0"
  }
}
